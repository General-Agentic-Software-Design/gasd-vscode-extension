VERSION 1.2
/* 
   --- Validation Spec: Negative Syntax ---
   Validates syntax failures and rejection edge cases.
*/
CONTEXT: "VS Code Extension Validation"
TARGET: "Mocha"
TRACE: "#US-41"

NAMESPACE: "gasd.vscode.validation.negative"

TYPE Requirement:
    name: String

COMPONENT NegativeValidator:
    PATTERN: "Error State Validator"
    INTERFACE:
        validate_failures() -> Boolean

FLOW validate_negative_scenarios():
    @trace("US-41") AS TR_NEG_VAL
    1. ACHIEVE "Load malformed GASD 1.2 syntax"
        POSTCONDITION: result != null
    2. MATCH "Lexer Output":
        "LEX_ERROR" | "PARSE_ERROR" -> LOG "Fatal errors successfully caught"
        DEFAULT -> THROW "False Positive"
    3. ACHIEVE "Load ACHIEVE block lacking POSTCONDITION in VERSION 1.2 file"
        POSTCONDITION: result != null
    4. MATCH "Diagnostic Output":
        "LINT-001 ERROR" -> LOG "LINT-001 correctly identified"
        DEFAULT -> THROW "GEP-6 POSTCONDITION Rule Failed"
    5. VALIDATE "Syntax is explicitly rejected when failing GEP-5 (VALIDATE without AS TYPE)" AS TYPE.Requirement
    6. RETURN "Success"

FLOW reject_invalid_contracts():
    1. ENSURE "Missing and empty BEHAVIORS and empty, guard-only, and timing-only cases each report LINT-007" @trace("NT-GEP7-001") AS TR_NO_OUTCOMES
        OTHERWISE THROW NegativeTestFailure
    2. ENSURE "Reject duplicate inputs, duplicate case names, unresolved interface methods, and mismatches in parameter count, order, types, or output" @trace("NT-GEP7-002") AS TR_INVALID_SIGNATURE
        OTHERWISE THROW NegativeTestFailure
    3. ENSURE "Reject undeclared guard values and fields, outcome bindings in guards, comparisons with incompatible types, nonnumeric ordering, and guards after case clauses" @trace("NT-GEP7-003") AS TR_INVALID_GUARD
        OTHERWISE THROW NegativeTestFailure
    4. ENSURE "Reject repeated THROWS and AFTER clauses, and negative, fractional, or nonnumeric retry counts"
        OTHERWISE THROW NegativeTestFailure
    5. ENSURE "A reached guard with a missing argument is a verification error. An unavailable result or error binding rules out the case"
        OTHERWISE THROW NegativeTestFailure

FLOW reject_invalid_entrypoints():
    1. ENSURE "Report same-document duplicates even when names match, and reject unknown, ambiguous, case-mismatched, nested, imported-only, quoted, empty, or multiple entry point identifiers" @trace("NT-GEP8-001") AS TR_ENTRYPOINT_LOCAL
        OTHERWISE THROW NegativeTestFailure
    2. ENSURE "Reject an ENTRYPOINT before CONTEXT or TARGET and in pre-1.2 files, while ordinary FLOW rules still apply for selected flows"
        OTHERWISE THROW NegativeTestFailure
    3. ENSURE "Reject combined executables with two declarations even across omitted, shared, or different namespaces and when names differ. Identify every source file and line and suppress combined AST export" @trace("NT-GEP8-004") AS TR_ENTRYPOINT_COMBINED
        OTHERWISE THROW NegativeTestFailure
    4. ENSURE "An unresolved source import fails explicit executable validation rather than hiding a potentially included entry point"
        OTHERWISE THROW NegativeTestFailure
    5. ENSURE "Target feasibility remains with the target generator. The editor supplies the resolved document and FLOW even for targets without standalone execution and for launch bindings unresolved at edit time" @trace("NT-GEP8-005") AS TR_EXECUTABLE_TARGET_HANDOFF @trace("NT-GEP8-006") AS TR_UNSUPPORTED_BINDING_HANDOFF
        OTHERWISE THROW NegativeTestFailure
