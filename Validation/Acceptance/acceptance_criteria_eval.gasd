VERSION 1.2
/* 
   --- Validation Spec: Acceptance Criteria ---
   Validates behavioral acceptance.
*/
CONTEXT: "VS Code Extension Validation"
TARGET: "TypeScript Test Frameworks"
TRACE: "#US-1-TO-41"

IMPORT "../../design/tests.gasd" AS TestingDesign

CONTRACT TestingDesign.AcceptanceTestSuite.test_gasd12_contract_signatures:
    OUTPUT: Void
    BEHAVIORS:
        CASE success:
            POSTCONDITION: result == void
    VERSION: "1.2.0"

NAMESPACE: "gasd.vscode.validation.acceptance"

TYPE Requirement:
    name: String

COMPONENT AcceptanceValidator:
    PATTERN: "Behavior Validator"
    INTERFACE:
        validate_ac() -> Boolean

FLOW validate_acceptance_behaviors():
    @trace("US-1-to-US-41") AS TR_AC_VAL
    1. ACHIEVE "Extract all AC IDs from Requirments/"
        POSTCONDITION: result != null
    2. ACHIEVE "Mock Document Change Event"
        POSTCONDITION: result != null
    3. VALIDATE "AST semantic diagnostics successfully return semantic triples for annotations" AS TYPE.Requirement
    4. ACHIEVE "Trigger GEP-6 specific semantic checks (LINT-001 to LINT-012)"
        POSTCONDITION: result != null
    5. RETURN "Success"

FLOW accept_gasd12_contracts():
    1. ENSURE "A contract referencing an interface by import alias accepts multiple typed parameters with nested generics and qualified types, and a zero-parameter method omits INPUT" @trace("AT-GEP7-001") AS TR_TYPED_SIGNATURE
        OTHERWISE THROW AcceptanceFailure
    2. ENSURE "Syntax and semantic AST exports retain two guards in source order, including field paths, and a false guard short-circuits an unavailable field in the following guard" @trace("AT-GEP7-002") AS TR_GUARD_AST
        OTHERWISE THROW AcceptanceFailure
    3. ENSURE "A null email matches the null-input exception, and non-null input can match success, retry, or timeout independently of case order" @trace("AT-GEP7-003") AS TR_ELIGIBLE_CASES
        OTHERWISE THROW AcceptanceFailure
    4. ENSURE "A normal return with missing quoted or timing evidence is unverified if the case could still match. Contradictory evidence or an impossible completion is a violation" @trace("AT-GEP7-004") AS TR_OUTCOME_EVIDENCE
        OTHERWISE THROW AcceptanceFailure
    5. ENSURE "The editor offers WHEN completion and reports the verified case through GASD: Verify Contract Call"
        OTHERWISE THROW AcceptanceFailure

FLOW accept_gasd12_entrypoints():
    1. ENSURE "The editor highlights and completes ENTRYPOINT, shows hover and a snippet, corrects keyword casing, suggests local FLOW names and navigates to the declared FLOW. The executable AST retains greet and both source locations" @trace("AT-GEP8-001") AS TR_ENTRYPOINT_EDITOR
        OTHERWISE THROW AcceptanceFailure
    2. ENSURE "Two top-level FLOWs may be reordered without changing the selected name" @trace("AT-GEP8-002") AS TR_ENTRYPOINT_ORDER
        OTHERWISE THROW AcceptanceFailure
    3. ENSURE "With a sole directive in a transitive import in a different namespace, validate successfully via the executable command and request. Supplying the same file directly, by aliases or paths resolving to the same file, or in a different root order yields the same export. Read open unsaved content" @trace("AT-GEP8-003") AS TR_ENTRYPOINT_IMPORTS
        OTHERWISE THROW AcceptanceFailure
    4. ENSURE "Validate and export a multi-file executable without a directive. The result has no startup identity and includes the validated source documents" @trace("AT-GEP8-005") AS TR_ENTRYPOINT_OPTIONAL
        OTHERWISE THROW AcceptanceFailure
    5. ENSURE "Select a FLOW with a String parameter and String result without changing ordinary FLOW validation" @trace("AT-GEP8-006") AS TR_ENTRYPOINT_SIGNATURE
        OTHERWISE THROW AcceptanceFailure
    6. ENSURE "At the generator boundary, preserve the original FLOW identity for compatible native names, typed flows called by other flows, Python and Node.js script launches, and flows with argument and status constraints" @trace("AT-GEP8-004") AS TR_NATIVE_HANDOFF @trace("AT-GEP8-007") AS TR_NAME_COLLISION_HANDOFF @trace("AT-GEP8-008") AS TR_SCRIPT_HANDOFF @trace("AT-GEP8-009") AS TR_BINDING_HANDOFF
        OTHERWISE THROW AcceptanceFailure
